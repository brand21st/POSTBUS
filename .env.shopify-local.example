# Copy to .env.shopify-local (gitignored). Fill keys from the hosted
# Supabase project named postbus-shopify-dev only. Never paste those
# keys into chat or docs. Never copy production JWTs here.
#
# POSTBUS_SHOPIFY_DEV_PROJECT_REF must match the ref in NEXT_PUBLIC_SUPABASE_URL
# and must never be hgacoeoovjxkzfbesmvl.
#
# npm run dev:shopify requires SHOPIFY_EMBEDDED_APP_ENABLED=true (the embedded app 404s otherwise).
# JOB_RUNNER=none is required so Next cannot drain background_jobs.
#
# Start with: npm run shopify:dev-gate   then   npm run dev:shopify
# Do not use npm run dev (that still loads production-connected .env.local).

POSTBUS_SHOPIFY_DEV=true
POSTBUS_SHOPIFY_DEV_PROJECT_REF=faanzcrnfndttbjpmlxu
POSTBUS_SHOPIFY_DEV_PROJECT_NAME=postbus-shopify-dev

NEXT_PUBLIC_APP_URL=http://localhost:3002
PORT=3002
NODE_ENV=development

NEXT_PUBLIC_SUPABASE_URL=https://faanzcrnfndttbjpmlxu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Generate locally (do not reuse production). The Shopify runner refuses the
# hardcoded crypto fallback. Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

JOB_RUNNER=none
CRON_SECRET=

SHOPIFY_EMBEDDED_APP_ENABLED=true
SHOPIFY_PUBLIC_APP_CLIENT_ID=
SHOPIFY_PUBLIC_APP_CLIENT_SECRET=
SHOPIFY_PUBLIC_APP_API_VERSION=2026-04

# Leave empty. Do not copy SHOPIFY_PUBLIC_APP_* here — the gate treats
# SHOPIFY_API_KEY/SECRET as BYO custom-app credentials and will refuse to start.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
VACHAT_API_KEY=
