{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "modules/**/*.ts",
    "modules/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "types/**/*.ts",
    "workers/**/*.ts",
    "proxy.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/standalone",
    ".next/server",
    ".next/static",
    ".next/cache",
    ".next-verify/standalone",
    ".next-verify/server",
    ".next-verify/static",
    ".next-verify/cache",
    ".worktrees",
    "print-agent-desktop",
    "print-agent",
    "scripts",
    "tests",
    "testsprite_tests",
    "**/*.test.ts",
    "**/*.pg.test.ts"
  ]
}
