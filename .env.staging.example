# Isolated PostBus staging. Copy to .env.staging (gitignored).
# NEVER point these at hgacoeoovjxkzfbesmvl.supabase.co or production.

STAGING_NAME=postbus-staging-local
STAGING_DATABASE_URL=postgresql://postbus_staging@127.0.0.1:55432/postbus_staging
CEPT_STUB_URL=http://127.0.0.1:4099
INDIA_POST_BOOKING_BATCH_SIZE=1
INDIA_POST_BOOKING_CONCURRENCY=2
JOB_RUNNER=database
NODE_ENV=test
INDIA_POST_WEBHOOK_ALLOWED_CIDRS=
INDIA_POST_TRACKING_SYNC_MIN_INTERVAL_MS=900000
INDIA_POST_TRACKING_SYNC_PAGE_SIZE=500
INDIA_POST_TRACKING_SYNC_ENQUEUE_LIMIT=50
