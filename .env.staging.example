# Isolated PostBus staging. Copy to .env.staging.local (gitignored) for `npm run dev:staging`.
# NEVER point NEXT_PUBLIC_SUPABASE_URL at hgacoeoovjxkzfbesmvl.supabase.co or production.
# `npm run dev:staging` refuses to start if this file is missing or production-pointed.
# Affiliate remote apply additionally requires an approved project ref that is
# not production, POSTBUS_AFFILIATE_STAGING_ENV=staging, and
# AFFILIATE_STAGING_WRITE_AUTHORIZATION=AFFILIATE_STAGING_WRITE_APPROVED.
# Do not set those values to force the gate; wait for explicit authorization.

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
PORT=3001
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_ISOLATED_STAGING_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTBUS_ENV=staging
# Hosted Stage B only: set to the approved non-production Supabase project ref (never hgacoeoovjxkzfbesmvl).
POSTBUS_STAGING_PROJECT_REF=
# Hosted mock hostname(s), comma-separated. Loopback is always allowed.
INDIA_POST_STAGING_ALLOWED_HOSTS=
POSTBUS_AFFILIATES_ENABLED=true
POSTBUS_AFFILIATE_ACCRUAL_ENABLED=false
POSTBUS_AFFILIATE_PAYOUTS_ENABLED=false
POSTBUS_BILLING_TAX_AUTOMATION_ENABLED=false
POSTBUS_BILLING_TAX_INVOICE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
INDIA_POST_BULK_ENABLED=false
INDIA_POST_UAT_BASE_URL=http://127.0.0.1:4099/beextcustomer
INDIA_POST_PROD_BASE_URL=http://127.0.0.1:4099/beextcustomer
INDIA_POST_MOCK_MODE=true
SHOPIFY_MOCK_MODE=true
SHOPIFY_EMBEDDED_APP_ENABLED=false
SHOPIFY_PUBLIC_APP_CLIENT_ID=
SHOPIFY_PUBLIC_APP_CLIENT_SECRET=
SHOPIFY_PUBLIC_APP_API_VERSION=2026-04
RAZORPAY_DISABLED=true
WHATSAPP_DISABLED=true
CRON_TEST_MODE=true

STAGING_NAME=postbus-staging-local
STAGING_DATABASE_URL=postgresql://postbus_staging@127.0.0.1:55432/postbus_staging
CEPT_STUB_URL=http://127.0.0.1:4099
INDIA_POST_BOOKING_BATCH_SIZE=1
INDIA_POST_BOOKING_CONCURRENCY=2
INDIA_POST_BULK_ENABLED=false
INDIA_POST_BULK_MAX_ARTICLES=2
INDIA_POST_BULK_CONCURRENCY=1
JOB_RUNNER=database
NODE_ENV=test
INDIA_POST_TRACKING_SYNC_MIN_INTERVAL_MS=900000
INDIA_POST_TRACKING_SYNC_PAGE_SIZE=500
INDIA_POST_TRACKING_SYNC_ENQUEUE_LIMIT=50
