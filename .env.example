# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for background jobs — they write across tenants and bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production. Encrypts integration and webhook secrets at rest.
INTEGRATION_ENCRYPTION_KEY=

# Background jobs. "database" drains background_jobs via POST /api/cron/jobs on a
# schedule and needs no Redis. "redis" hands jobs to BullMQ and requires `npm run workers`.
JOB_RUNNER=database
# Required when JOB_RUNNER=database — authenticates the scheduled drain request.
CRON_SECRET=

# Redis / BullMQ (only used when JOB_RUNNER=redis)
REDIS_URL=redis://127.0.0.1:6379

# Optional platform-level Shopify app fallback. Merchants can also save Client ID/secret per workspace.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_fulfillments,write_fulfillments,read_locations
SHOPIFY_APP_URL=http://localhost:3000

# India Post CEPT hosts. Login/tariff/tracking live under /beextcustomer/v1;
# booking is POST /beextcustomer/process-articles/{customerId} (no /v1).
INDIA_POST_UAT_BASE_URL=https://test.cept.gov.in/beextcustomer/v1
INDIA_POST_PROD_BASE_URL=https://app.indiapost.gov.in

# Billing processor — omit to show Billing configuration required
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
