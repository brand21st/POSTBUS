# App
# Production must be https://www.postbus.in and match Supabase Auth Site URL + redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional: auto-register merchant tracking subdomains on Coolify when a page is published or renamed.
# From the app container use host.docker.internal, not the public VPS IP.
COOLIFY_BASE_URL=http://host.docker.internal:8000
COOLIFY_APPLICATION_UUID=
COOLIFY_API_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for background jobs — they write across tenants and bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production. Encrypts integration and webhook secrets at rest.
INTEGRATION_ENCRYPTION_KEY=

# Background jobs. "database" drains background_jobs via POST /api/cron/jobs on a
# schedule and needs no Redis. "redis" hands jobs to BullMQ and requires `npm run workers`.
JOB_RUNNER=database
# Required when JOB_RUNNER=database — authenticates the scheduled drain request.
CRON_SECRET=

# Redis / BullMQ (only used when JOB_RUNNER=redis)
REDIS_URL=redis://127.0.0.1:6379

# Optional platform-level Shopify app fallback. Merchants can also save Client ID/secret per workspace.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_fulfillments,write_fulfillments,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_locations
SHOPIFY_APP_URL=http://localhost:3000

# India Post CEPT root (no trailing /v1). Login uses {root}/v1/access/login;
# booking uses {root}/process-articles/{customerId}.
INDIA_POST_UAT_BASE_URL=https://test.cept.gov.in/beextcustomer
INDIA_POST_PROD_BASE_URL=https://app.indiapost.gov.in/beextcustomer
# Booking worker concurrency and CEPT batch size (1 = one article per request, up to 5000).
INDIA_POST_BOOKING_CONCURRENCY=4
INDIA_POST_BOOKING_BATCH_SIZE=1
# Optional CEPT webhook source CIDRs (comma-separated). Empty = quarantined (HTTP 200, no ingest). Do not invent HMAC.
INDIA_POST_WEBHOOK_ALLOWED_CIDRS=
# Bounded bulk tracking sync. Interval skips recently polled active shipments.
INDIA_POST_TRACKING_SYNC_MIN_INTERVAL_MS=900000
INDIA_POST_TRACKING_SYNC_PAGE_SIZE=500
INDIA_POST_TRACKING_SYNC_ENQUEUE_LIMIT=50
# Optional: binary-split HTTP 400/403/404 bulk tracking pages. Do not raise without CEPT evidence.
INDIA_POST_TRACKING_ISOLATE_MAX_REQUESTS=32
INDIA_POST_TRACKING_AUTH_COOLDOWN_MS=1800000
INDIA_POST_TRACKING_LOOKUP_COOLDOWN_MS=900000
# P0 ingest canary. Empty organization = fleet stays on legacy tracking-sync (400 still stamps last_tracked_at).
# Set both org UUID and comma-separated AWBs (max 5) only for an approved live canary.
INDIA_POST_TRACKING_P0_CANARY_ORGANIZATION_ID=
INDIA_POST_TRACKING_P0_CANARY_AWBS=
INDIA_POST_TRACKING_P0_CANARY_SIDE_EFFECTS=off

# Razorpay billing fallback. Super Admins can also save keys under /admin/settings
# (encrypted in platform_settings). Env values are used when the database row is empty.
# Never put RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET in NEXT_PUBLIC_* variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# WhatsApp OTP sign-in. Default off. Password login stays available either way.
# Do not enable in production until duplicate WhatsApp numbers are resolved
# and a VaChat AUTHENTICATION template is approved on the PostBus number.
AUTH_WHATSAPP_OTP_ENABLED=false
# HMAC pepper for OTP challenges. Server-only. Not the integration encryption key.
OTP_PEPPER=
# Approved Meta AUTHENTICATION template name on the platform VaChat account.
VACHAT_OTP_TEMPLATE_NAME=
VACHAT_OTP_TEMPLATE_LANGUAGE=en

# Super Admin confirmation PIN for account block / suspend / hold / delete.
ADMIN_ACCOUNT_ACTION_PIN=884877

# Shipping label PDFs. Coolify must mount a persistent volume at this path
# (destination /data/labels). Do not serve this directory on Traefik/Nginx.
LABEL_STORAGE_PATH=/data/labels

# Postbus-generated PDFs (custom labels, packing slips, receipts, invoices).
# Default is on. Set false only to roll back to Helvetica-only drawing.
POSTBUS_UNICODE_LABEL_RENDERING=true

# Shipping invoice PDFs. Defaults to a folder on the labels volume so files
# survive container restarts. Override only if you mount a dedicated volume.
INVOICE_STORAGE_PATH=/data/labels/invoices

# Optional Microsoft Clarity on marketing pages only.
NEXT_PUBLIC_ENABLE_CLARITY=false

# PostHog product analytics. The project token is public (it ships in the browser).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
