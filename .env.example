# App
# Production must be https://www.postbus.in and match Supabase Auth Site URL + redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for background jobs — they write across tenants and bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production. Encrypts integration and webhook secrets at rest.
INTEGRATION_ENCRYPTION_KEY=

# Background jobs. "database" drains background_jobs via POST /api/cron/jobs on a
# schedule and needs no Redis. "redis" hands jobs to BullMQ and requires `npm run workers`.
JOB_RUNNER=database
# Required when JOB_RUNNER=database — authenticates the scheduled drain request.
CRON_SECRET=

# Redis / BullMQ (only used when JOB_RUNNER=redis)
REDIS_URL=redis://127.0.0.1:6379

# Optional platform-level Shopify app fallback. Merchants can also save Client ID/secret per workspace.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_fulfillments,write_fulfillments,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_locations
SHOPIFY_APP_URL=http://localhost:3000

# India Post CEPT root (no trailing /v1). Login uses {root}/v1/access/login;
# booking uses {root}/process-articles/{customerId}.
INDIA_POST_UAT_BASE_URL=https://test.cept.gov.in/beextcustomer
INDIA_POST_PROD_BASE_URL=https://app.indiapost.gov.in/beextcustomer

# Razorpay billing. Key ID is also exposed to Checkout via NEXT_PUBLIC_RAZORPAY_KEY_ID.
# Never put RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET in NEXT_PUBLIC_* variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional: first Super Admin email. Matching signed-in users are granted platform_admins access.
PLATFORM_ADMIN_EMAIL=

# Shipping label PDFs. Coolify must mount a persistent volume at this path
# (destination /data/labels). Do not serve this directory on Traefik/Nginx.
LABEL_STORAGE_PATH=/data/labels

# Shipping invoice PDFs. Defaults to a folder on the labels volume so files
# survive container restarts. Override only if you mount a dedicated volume.
INVOICE_STORAGE_PATH=/data/labels/invoices

# Optional Microsoft Clarity on marketing pages only.
NEXT_PUBLIC_ENABLE_CLARITY=false
