# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required in production. Encrypts integration and webhook secrets at rest.
INTEGRATION_ENCRYPTION_KEY=

# Redis / BullMQ (required for workers)
REDIS_URL=redis://127.0.0.1:6379

# Optional platform-level Shopify app fallback. Merchants can also save Client ID/secret per workspace.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_fulfillments,write_fulfillments,read_locations
SHOPIFY_APP_URL=http://localhost:3000

# India Post CEPT REST base URLs (include /v1 — provider appends /access/login etc).
# UAT defaults in code if unset. Set PROD when CEPT shares the live host.
INDIA_POST_UAT_BASE_URL=https://test.cept.gov.in/beextcustomer/v1
INDIA_POST_PROD_BASE_URL=

# Billing processor — omit to show Billing configuration required
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
