# Copy to .env in this directory. Never commit .env.
# Run only on the CEPT-whitelisted PostBus VPS.

INDIA_POST_ENVIRONMENT=production
INDIA_POST_BASE_URL=https://app.indiapost.gov.in/beextcustomer
INDIA_POST_USERNAME=
INDIA_POST_PASSWORD=
INDIA_POST_CUSTOMER_ID=
INDIA_POST_TRACKING_BARCODE=

# Verified in PostBus CEPT AUTH02 (not listed in the approach document).
# POST {base}/v1/access/TokenWithRtoken  Authorization: Bearer <refresh_token>  empty body
INDIA_POST_REFRESH_ENDPOINT=/access/TokenWithRtoken

# Fail closed unless the observed HTTPS egress IPv4 matches this value.
INDIA_POST_EXPECTED_EGRESS_IP=89.116.34.166

# Optional read-only control test against GET /v1/pincode-search
INDIA_POST_CONTROL_PINCODE=110001
